# Neon Postgres — à définir dans Vercel (Settings → Environment Variables)
# Format : postgresql://utilisateur:mot_de_passe@hote/base?sslmode=require
# Utiliser l'URL « pooler » de Neon pour le runtime serverless.
DATABASE_URL=

# Amorçage du premier propriétaire — usage local et ponctuel, jamais en variables Vercel.
# Aucune inscription publique : ce script crée le tenant et son propriétaire une seule fois.
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
